{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Northstar",
  "version": "0.1.0",
  "identifier": "com.emrisca.northstar",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Northstar Field CAD",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all"
  }
}
